# Port Backend Express
PORT=5000

# ==========================================
# KONFIGURASI DATABASE AIVEN MYSQL
# ==========================================
# Opsi 1: Menggunakan Service URI langsung dari Dashboard Aiven (Direkomendasikan)
# Contoh: DATABASE_URL=mysql://avnadmin:AVNS_AbCd1234@mysql-2a1b3c4d-myproject.aivencloud.com:28394/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=

# Opsi 2: Menggunakan Variabel Terpisah dari Dashboard Aiven
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=false
